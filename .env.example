# Development only. Cloud production requires PostgreSQL and a strong SESSION_SECRET.
APP_ENV=development
DEMO_MODE=true
ALLOW_CLOUD_DEMO=false
DATABASE_URL=sqlite:///./data/prototype.db
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
UPLOAD_DIR=./data/uploads
PORT=8000
PUBLIC_ORIGIN=http://localhost:8000

# Lark company login / read-only sources. Never expose these in frontend variables.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REDIRECT_URI=https://YOUR_DOMAIN.zeabur.app/api/auth/lark/callback
LARK_ALLOWED_TENANTS=
LARK_ROLE_MAP_JSON={}
# Private exact OAuth/app/tenant administrator grants with owner decision metadata.
# An ordinary role/bootstrap flag alone does not grant independent business admission.
LARK_COMPANY_ADMIN_GRANTS_JSON=[]
LARK_OAUTH_SCOPES=bitable:app:readonly approval:approval:readonly
LARK_SOURCE_MAX_PAGES=50
# Full example stored in deployment/source-tables.json (IDs are not credentials).
LARK_SOURCE_TABLES_JSON=[]

# Application identity for the allowed company; never reuse local CLI credentials.
LARK_WORKER_IDENTITY=application
LARK_WORKER_ORGANIZATION=

# Live read (opt-in; see docs/LIVE_READ_20261007.md). Off by default: the worker keeps its
# 300-second source/roster/attendance timers. Roll back by setting false and restarting.
# Requires LARK_WORKER_IDENTITY=application. Values below are the defaults; minimums apply.
LARK_LIVE_READ_ENABLED=false
# Defaults 60 when enabled, 300 when disabled (minimum 30); attendance default 300 (minimum 60).
LARK_LIVE_READ_SOURCE_TTL_SECONDS=
LARK_LIVE_READ_ROSTER_TTL_SECONDS=
LARK_LIVE_READ_ATTENDANCE_TTL_SECONDS=
# Per-process Lark request rate, 0.01-10 (default 5); wait limit default 10 (min 0.01); lease default 120 (min 60).
LARK_LIVE_READ_MAX_RPS=
LARK_LIVE_READ_BLOCKING_TIMEOUT_SECONDS=
LARK_LIVE_READ_LEASE_SECONDS=
# Bitable record endpoint: list (default, 200/page) or search (500/page). Verify on staging before search.
LARK_BITABLE_RECORDS_API=list
# Enable only after contact scopes and same-app employee IDs have been verified.
LARK_ATTENDANCE_IDENTITY_RESOLUTION=
# Submission remains disabled throughout public demo and real-role acceptance.
LARK_NATIVE_APPROVAL_SUBMIT_ENABLED=false
LARK_NATIVE_APPROVAL_MAPPINGS_JSON={}

# Dedicated append-only Input destination, also allowed in workspace settings.
LARK_INPUT_BASE_TOKEN=
LARK_INPUT_TABLE_ID=
# Nine semantic keys mapped to {field_id,field_name}; see input_registration.FIELD_NAMES.
LARK_INPUT_REGISTRATION_FIELDS_JSON={}
LARK_TEST_BASE_TOKEN=
LARK_TEST_INPUT_TABLE_ID=
LARK_TEST_INPUT_REGISTRATION_FIELDS_JSON={}
LARK_TEST_DRIVE_ROOT=
LARK_DRIVE_ROOT=

# Persistent private storage outside UPLOAD_DIR. Blank leaves scheduler disabled.
# Configure a persistent volume; /tmp is not retained after replacement deployments.
BACKUP_DIR=
BACKUP_OFFSITE_ENABLED=false
BACKUP_DRIVE_ROOT_TOKEN=
BACKUP_DRIVE_ALLOWED_ROOT=
# Set true only after reviewing actual folder access; this does not change ACLs.
BACKUP_DRIVE_PRIVATE_ROOT_VERIFIED=false
# Private JSON array of Fernet keys, newest first. Keep recovery keys separately.
BACKUP_ENCRYPTION_KEYS_JSON=[]
# Restore drill only: supply privately to a one-off process, never the web/worker.
# Must identify a separately named, empty PostgreSQL database.
RESTORE_DRILL_DATABASE_URL=
